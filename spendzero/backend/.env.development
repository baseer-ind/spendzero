# Loaded automatically when SPENDZERO_ENV is unset or "development" — this
# is the zero-config local dev setup, matching docker-compose.yml exactly.
# Safe to commit: no real secrets, only points at your own local containers.

# development | staging | production
SPENDZERO_ENVIRONMENT=development

# Async SQLAlchemy URL. Matches docker-compose.yml's `db` service.
SPENDZERO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spendzero

# Matches docker-compose.yml's `redis` service.
SPENDZERO_REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed origins for the mobile/web client, or "*"
# for local dev. Tighten this for staging/production.
SPENDZERO_CORS_ORIGINS=*

# Leave blank until Supabase auth is wired up (guest mode works without these).
SPENDZERO_SUPABASE_URL=
SPENDZERO_SUPABASE_JWT_SECRET=

# Seeds a fully-populated demo guest user (goals, streak, stats, history) on
# every `python -m app.db.seed` run so a fresh install never looks empty.
# Turn this off for staging/production.
SPENDZERO_SEED_DEMO_USER=true

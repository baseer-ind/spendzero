# Copy to `.env.staging` and fill in real values — never commit the copy.
# Loaded when you run the backend with SPENDZERO_ENV=staging.

SPENDZERO_ENVIRONMENT=staging
SPENDZERO_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@STAGING_DB_HOST:5432/spendzero
SPENDZERO_REDIS_URL=redis://STAGING_REDIS_HOST:6379/0
SPENDZERO_CORS_ORIGINS=https://staging.spendzero.app
SPENDZERO_SUPABASE_URL=
SPENDZERO_SUPABASE_JWT_SECRET=
SPENDZERO_SEED_DEMO_USER=false

# Copy to `.env.production` and fill in real values — never commit the copy.
# Loaded when you run the backend with SPENDZERO_ENV=production.

SPENDZERO_ENVIRONMENT=production
SPENDZERO_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PROD_DB_HOST:5432/spendzero
SPENDZERO_REDIS_URL=redis://PROD_REDIS_HOST:6379/0
SPENDZERO_CORS_ORIGINS=https://spendzero.app
SPENDZERO_SUPABASE_URL=
SPENDZERO_SUPABASE_JWT_SECRET=
SPENDZERO_SEED_DEMO_USER=false

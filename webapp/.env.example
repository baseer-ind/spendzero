# SELFly client environment (copy to .env for local dev; set the same two vars in
# Vercel → Project → Settings → Environment Variables for production).
#
# These are CLIENT-SAFE: the publishable/anon key is designed to ship in the
# browser and is protected by Row Level Security. The service-role key is NEVER
# used in the client and must only ever live in server-side / Edge Function env.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL (set in Vercel when the real domain is connected, e.g.
# https://selfly.app). Drives canonical + OG/Twitter absolute image URLs.
VITE_SITE_URL=https://your-domain.example
